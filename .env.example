# 复制为 .env.local 后填入实际值

# ─── AI 解读（/api/interpret、/api/heming，OpenAI 兼容协议）───
# 只想排盘、看命盘的话不用填；填了之后命盘页右侧解读与合盘分析即可用。
OPENAI_API_KEY=sk-your-openai-key
# 走 OpenAI 兼容网关（DeepSeek / 自建等）时设置，直连 OpenAI 留空
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# 默认 gpt-5.5
# OPENAI_MODEL=gpt-5.5
# 推理深度 none | low | medium | high；不设则不传该参数（本地思考型模型如 qwen3.5 需设 none）
# OPENAI_REASONING_EFFORT=medium

# ─── 或者接本机 Ollama（OrbStack VM 内用 host.orb.internal 访问宿主机）───
# OPENAI_BASE_URL=http://host.orb.internal:11434/v1
# OPENAI_API_KEY=ollama
# OPENAI_MODEL=qwen3.5:122b
# OPENAI_REASONING_EFFORT=none

# ─── 站点 ───
NEXT_PUBLIC_SITE_URL=http://localhost:3000
